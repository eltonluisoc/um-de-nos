# Copie para ".env" (que é ignorado pelo git) OU use serviceAccountKey.json na raiz.

# Conteúdo do JSON da chave de serviço do Firebase, em UMA linha.
# No GitHub Actions isso vira um "Secret". Localmente é mais fácil usar o arquivo
# serviceAccountKey.json (basta baixá-lo do console e salvar na raiz do projeto).
FIREBASE_SERVICE_ACCOUNT=

# Para onde vão os e-mails de aviso (novo sorteio / vencedor).
EMAIL_DESTINO=eltonluisoc@gmail.com

# ID do formsubmit.co usado para disparar e-mail (o mesmo do antigo cron.html).
FORMSUBMIT_ID=7323b499eb65357bcf8f13bdb5ac55bf

# Limite de segurança: nº máximo de concursos importados por execução.
MAX_CONCURSOS=90
